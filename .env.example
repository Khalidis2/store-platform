# Application Postgres connection string (Supabase or Neon both work well with Vercel).
# Never point DB-backed automated tests at this database.
DATABASE_URL=postgres://user:password@host:5432/app_db

# Dedicated non-production database used only by Vitest DB-backed integration tests.
# `npm test` refuses to run DB-backed tests without this value and also refuses
# when it is identical to DATABASE_URL.
TEST_DATABASE_URL=postgres://user:password@host:5432/test_db

# Supabase Auth (from Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects the stale-reservation sweep endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Carrier tracking via AfterShip (Aramex + Emirates Post through one API).
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=
