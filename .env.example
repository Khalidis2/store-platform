# Postgres connection string (Supabase or Neon both work well with Vercel).
# If using Supabase, this is the same project as the auth vars below.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Supabase Auth (from Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Filled in during Phase 4 (Stripe Connect)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Filled in during Phase 9 - protects the stale-reservation sweep endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Filled in during Phase 17 (carrier tracking via AfterShip - supports both
# Aramex and Emirates Post through one API). Free tier available.
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=
