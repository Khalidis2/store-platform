# Application Postgres connection string (Supabase or Neon both work well with Vercel).
DATABASE_URL=postgres://user:password@host:5432/app_db

# Dedicated non-production database used only by Vitest DB-backed integration tests.
TEST_DATABASE_URL=postgres://user:password@host:5432/test_db

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email via Resend. PLATFORM_ROOT_URL is the canonical custom
# production root origin, e.g. https://shops.example.com. Do not use a
# vercel.app deployment URL or wildcard host here.
RESEND_API_KEY=
EMAIL_FROM=
PLATFORM_ROOT_URL=

# Protects authenticated maintenance/retry endpoints.
CRON_SECRET=

# Carrier tracking via AfterShip (Aramex + Emirates Post through one API).
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# External production error monitoring.
SENTRY_DSN=

# Enable only when the production edge/reverse proxy strips client-supplied
# forwarded-IP headers and replaces them with trusted values.
TRUST_PROXY_HEADERS=false
